generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

//
// ENUMS
//

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum GroupStatus {
  ACTIVE
  CLOSED
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MentorshipStatus {
  REQUESTED
  APPROVED
  COMPLETED
  CANCELLED
}

//
// USER
//

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo          String?  @db.VarChar(255)
  socialNetwork  String?  @db.VarChar(255)
  knowledgeLevel String?  @db.VarChar(20)
  interests      String[] @default([])
  availability   String?  @db.VarChar(100)

  mentorTechnologies String[] @default([])
  calendlyUrl        String?  @db.VarChar(255)

  isBlocked Boolean @default(false)

  // RELATIONS
  threads Thread[]
  replies Reply[]

  groupsCreated Group[]       @relation("GroupMentor")
  memberships   GroupMember[]

  mentorSessions  Mentorship[] @relation("Mentor")
  studentSessions Mentorship[] @relation("Student")
}

//
// FORUM
//

model Category {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(100)

  threadCategories ThreadCategory[]
}

model Thread {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(100)
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  threadCategories ThreadCategory[]

  replies Reply[]
}

model ThreadCategory {
  threadId   String
  categoryId String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([threadId, categoryId])
}

model Reply {
  id        String   @id @default(uuid())
  content   String
  votes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  threadId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

//
// GROUPS
//

model Group {
  id           String      @id @default(uuid())
  name         String
  description  String?
  technology   String?     @db.VarChar(50)
  level        String?     @db.VarChar(20)
  materialsUrl String?     @db.VarChar(255)
  status       GroupStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  creatorId String
  creator   User   @relation("GroupMentor", fields: [creatorId], references: [id], onDelete: Cascade)

  members GroupMember[]
}

model GroupMember {
  id        String       @id @default(uuid())
  status    MemberStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

//
// MENTORSHIP
//

model Mentorship {
  id        String           @id @default(uuid())
  status    MentorshipStatus @default(REQUESTED)
  accessUrl String?          @db.VarChar(255)
  rating    Int?
  comment   String?          @db.VarChar(255)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  mentorId  String
  studentId String

  mentor  User @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  student User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)
}
