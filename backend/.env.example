
##########################################
# DATABASE - SUPABASE (PRISMA)
##########################################

# Pooler (usado pela aplicação)
DATABASE_URL="postgresql://postgres.PROJECT_ID:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (usado pelo Prisma para migrations)
DIRECT_URL="postgresql://postgres:SUA_SENHA@db.PROJECT_ID.supabase.co:5432/postgres"


##########################################
# AUTH (JWT)
##########################################

JWT_SECRET="COLE_A_CHAVE_JWT_COMPARTILHADA_AQUI"


##########################################
# SERVER
##########################################

PORT=3000

# Em produção, informe as origens completas do frontend, separadas por vírgula.
# Exemplo: CORS_ORIGINS="https://app.seudominio.com,https://admin.seudominio.com"
# Em desenvolvimento, localhost:5173 e 127.0.0.1:5173 são permitidos por padrão.
CORS_ORIGINS=


##########################################
# OPCIONAL (FRONTEND / SUPABASE)
##########################################

SUPABASE_URL="https://PROJECT_ID.supabase.co"
SUPABASE_KEY="sua_chave_publica_aqui"
